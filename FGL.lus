    "เก็บปืนอัตโนมัติ",
    false,
    function(state)

        _G.AutoCollectGun = state

        if not state then
            return
        end

        task.spawn(function()

            while _G.AutoCollectGun do

                task.wait(0.1)

                pcall(function()

                    local Character = GetCharacter()
                    local RootPart =
                        Character:FindFirstChild("HumanoidRootPart")

                    local Gun =
                        workspace:FindFirstChild("GunDrop")
                        or workspace:FindFirstChild("Gun")

                    if RootPart and Gun then

                        if Gun:IsA("BasePart") then
                            RootPart.CFrame = Gun.CFrame
                        elseif Gun:IsA("Model") then

                            local PrimaryPart = Gun.PrimaryPart

                            if PrimaryPart then
                                RootPart.CFrame =
                                    PrimaryPart.CFrame
                            end
                        end
                    end

                end)
            end

        end)
    end
)

