--// ==========================================
--// DRAG SYSTEM
--// ==========================================

local Dragging = false
local DragInput = nil
local DragStart = nil
local StartPosition = nil

TopBar.InputBegan:Connect(function(input)

    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

        Dragging = true
        DragStart = input.Position
        StartPosition = MainFrame.Position

        input.Changed:Connect(function()

            if input.UserInputState == Enum.UserInputState.End then
                Dragging = false
            end

        end)

    end

end)

TopBar.InputChanged:Connect(function(input)

    if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then

        DragInput = input

    end

end)

UserInputService.InputChanged:Connect(function(input)

    if input == DragInput and Dragging then

        local Delta =
            input.Position - DragStart

        MainFrame.Position =
            UDim2.new(
                StartPosition.X.Scale,
                StartPosition.X.Offset + Delta.X,
                StartPosition.Y.Scale,
                StartPosition.Y.Offset + Delta.Y
            )

    end

end)

--// ==========================================
--// CHARACTER RESPAWN SUPPORT
--// ==========================================

LocalPlayer.CharacterAdded:Connect(function(character)

    task.wait(0.5)

    local Humanoid =
        character:FindFirstChildOfClass("Humanoid")

    if not Humanoid then
        return
    end

    -- คืนค่า Speed/Jump ตามสถานะ Toggle
    if _G.SpeedEnabled then
        Humanoid.WalkSpeed = 60
    end

    if _G.JumpEnabled then
        Humanoid.UseJumpPower = true
        Humanoid.JumpPower = 110
    end

end)

--// ==========================================
--// CLEANUP WHEN GUI IS DESTROYED
--// ==========================================

ScreenGui.Destroying:Connect(function()

    _G.AutoCollectGun = false
    _G.AntiFling = false
    _G.ESP_Players = false
    _G.ESP_Items = false
    _G.AutoCollectCoins = false
    _G.FlingEnabled = false

    ClearAllESP()

end)

--// ==========================================
--// OPTIONAL EXTERNAL SCRIPT
--// ==========================================

if EXTERNAL_SCRIPT_URL
    and EXTERNAL_SCRIPT_URL ~= "" then

    task.spawn(function()

        pcall(function()

            local Source =
                game:HttpGet(EXTERNAL_SCRIPT_URL)

            local LoadedFunction =
                loadstring(Source)

            if LoadedFunction then
                LoadedFunction()
            else
                warn("ไม่สามารถ compile external script ได้")
            end

        end)

    end)

end

print("BHK2_Mambo GUI loaded successfully.")
