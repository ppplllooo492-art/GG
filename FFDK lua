--------------------------------------------------

BtnCheckKey.MouseButton1Click:Connect(function()

    if KeyTextBox.Text ~= correctKey then
        KeyStatus.TextColor3 = Color3.fromRGB(255, 59, 48)
        KeyStatus.Text = "Invalid Key, Try Again."
        KeyTextBox.Text = ""
        return
    end

    KeyStatus.TextColor3 = Color3.fromRGB(0, 255, 0)
    KeyStatus.Text = "Authorized! Launching..."

    task.wait(0.8)

    if KeyFrame then
        KeyFrame:Destroy()
    end

    MainFrame.Visible = true
    ToggleIconButton.Visible = true

    StatusLabel.Text = "Status: Operational"

    --------------------------------------------------
    -- Pull BuyChickens
    --------------------------------------------------

    task.spawn(function()
        while task.wait(0.2) do

            if config.PullBuyButton then

                pcall(function()

                    if not rootPart then
                        return
                    end

                    local plots = workspace:FindFirstChild("Plots")

                    if not plots then
                        return
                    end

                    local plot = plots:FindFirstChild("BBBR17k")

                    if not plot then
                        return
                    end

                    local buttons = plot:FindFirstChild("Buttons")

                    if not buttons then
                        return
                    end

                    local buyTarget =
                        buttons:FindFirstChild("BuyChickens")

                    if not buyTarget then
                        return
                    end

                    if buyTarget:IsA("BasePart") then

                        buyTarget.CFrame = rootPart.CFrame

                    elseif buyTarget:IsA("Model") then

                        if buyTarget.PrimaryPart then
                            buyTarget:SetPrimaryPartCFrame(
                                rootPart.CFrame
                            )
                        else
                            local buttonPart =
                                buyTarget:FindFirstChild("Button")

                            if buttonPart
                                and buttonPart:IsA("BasePart") then

                                buttonPart.CFrame =
                                    rootPart.CFrame
                            end
                        end
                    end

                end)

            end
        end
    end)

    --------------------------------------------------
    -- Auto Lucky Block
    --------------------------------------------------

    task.spawn(function()

        while task.wait(0.3) do

            if config.AutoLucky
                and remoteFunction then

                pcall(function()

                    remoteFunction:InvokeServer(
                        "Open Lucky Block"
                    )

                end)

            end
        end

    end)

    --------------------------------------------------
    -- FPS
    --------------------------------------------------

    local frames = 0
    local lastTime = tick()

    RunService.RenderStepped:Connect(function()

        frames += 1

        local now = tick()

        if now - lastTime >= 1 then

            local fps = frames
            frames = 0
            lastTime = now

            local ping = 0

            pcall(function()
                ping =
                    math.floor(
                        player:GetNetworkPing() * 1000
                    )
            end)

            StatLabel.Text =
                "FPS: "
                .. tostring(fps)
                .. " | Ping: "
                .. tostring(ping)
                .. " ms"
        end

    end)

    --------------------------------------------------
    -- Anti AFK
    --------------------------------------------------

    if config.AntiAFK then

        pcall(function()

            player.Idled:Connect(function()

                VirtualUser:CaptureController()

                VirtualUser:ClickButton2(
                    Vector2.new(0, 0)
                )

            end)

        end)

    end

end)
