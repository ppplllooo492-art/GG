local function teleportTo(targetPart)
    if not rootPart or not targetPart then
        return
    end

    if targetPart:IsA("BasePart") then
        rootPart.CFrame = targetPart.CFrame + Vector3.new(0, 3, 0)

    elseif targetPart:IsA("Model") and targetPart.PrimaryPart then
        rootPart.CFrame =
            targetPart.PrimaryPart.CFrame + Vector3.new(0, 3, 0)
    end
end

local function isButtonRed(buttonPart)
    if not buttonPart or not buttonPart:IsA("BasePart") then
        return false
    end

    local color = buttonPart.Color

    if buttonPart.BrickColor == BrickColor.new("Bright red") then
        return true
    end

    if color.R > 0.7 and color.G < 0.3 and color.B < 0.3 then
        return true
    end

    return false
end

