local function toggleState(btn, configKey, name)
    config[configKey] = not config[configKey]

    if config[configKey] then
        btn.BackgroundColor3 = Color3.fromRGB(0, 122, 255)
        btn.Text = name .. " [ON]"
    else
        btn.BackgroundColor3 = Color3.fromRGB(40, 40, 55)
        btn.Text = name .. " [OFF]"
    end
end

